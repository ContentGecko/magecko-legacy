    justify-content: flex-end;
    margin-top: 16px;
}
.magecko-pager a,
.magecko-pager strong {
    min-width: 32px;
    padding: 7px 10px;
    text-align: center;
}
.magecko-status {
    border-radius: 3px;
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
