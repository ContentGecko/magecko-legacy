<script>
require([
    'jquery',
    'mage/adminhtml/wysiwyg/tiny_mce/setup'
], function ($, WysiwygSetup) {
    'use strict';

    var wysiwygConfig = <?= /* @noEscape */ $block->getWysiwygConfigJson() ?>;

    function syncEditors() {
        if (!window.tinyMCE) {
            return;
        }

        $('.magecko-wysiwyg').each(function () {
            var editor = window.tinyMCE.get(this.id);
            if (editor) {
                this.value = editor.getContent();
            }
        });
    }

    $('.magecko-wysiwyg').each(function () {
        if (!this.id) {
            return;
        }

        if (window.tinyMCE && window.tinyMCE.get(this.id)) {
            return;
        }

        new WysiwygSetup(this.id, $.extend(true, {}, wysiwygConfig)).setup();
    });

    $('#magecko-blog-post-form').on('submit', syncEditors);

    var featuredInput = document.getElementById('featured_image_file');
    var featuredPreview = document.getElementById('magecko-featured-new-preview');
    var featuredPreviewUrl = null;
    if (featuredInput && featuredPreview) {
        featuredInput.addEventListener('change', function () {
            var file = featuredInput.files && featuredInput.files[0];
            var image = featuredPreview.querySelector('img');
            var label = featuredPreview.querySelector('span');
            if (featuredPreviewUrl) {
                URL.revokeObjectURL(featuredPreviewUrl);
                featuredPreviewUrl = null;
            }

            if (!file) {
                featuredPreview.hidden = true;
                image.removeAttribute('src');
                label.textContent = '';
                return;
            }

            featuredPreviewUrl = URL.createObjectURL(file);
            image.src = featuredPreviewUrl;
            label.textContent = file.name + ' (' + Math.round(file.size / 1024) + ' KB)';
            featuredPreview.hidden = false;
        });
    }

    var title = document.getElementById('title');
    var slug = document.getElementById('slug');
    if (title && slug) {
        title.addEventListener('input', function () {
            if (slug.value.trim() !== '') {
                return;
            }

            slug.value = title.value
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '');
        });
    }
});
</script>
